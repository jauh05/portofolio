# Salin ke .env lalu isi. Jangan di-commit.
# Kosongkan LITELLM_API_KEY jika proxy LiteLLM lokal tidak memakai master key.
LITELLM_API_KEY=
# Opsional: ganti font untuk teks overlay (hindari karakter ":" di path).
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Reels dikirim ke Telegram setelah dirender, lengkap dengan jam dan caption untuk diunggah manual ke TikTok.
# Pakai bot Jauki yang sama. TELEGRAM_CHAT_ID adalah id chat pribadi Anda (sama dengan ALLOWED_TELEGRAM_USER_ID di bot Jauki).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Video dirender sekian menit sebelum jam tayang. Bawaan 1440 (sehari sebelumnya).
# REELS_LEAD_MINUTES=1440
