# Worker artikel Living AI Office (Kauiz dan Jauki). Salin ke worker.env, isi nilai rahasia sendiri, lalu chmod 600.

# Bridge dashboard (sama dengan .env bot Jauki)
OFFICE_BRIDGE_URL=
OFFICE_BRIDGE_TOKEN=

# Token API artikel masing-masing situs (CONTENT_BOT_TOKEN di .env situs itu). Tiap situs punya token sendiri.
ARTICLE_KAUIZ_TOKEN=
ARTICLE_JAUKI_TOKEN=
# Opsional: alamat dasar bila berbeda dari bawaan
# ARTICLE_KAUIZ_BASE_URL=https://kauiz.web.id/v1/internal
# ARTICLE_JAUKI_BASE_URL=https://jaukitugas.my.id/api/internal

# Model teks dan Muse lewat OpenRouter (kunci yang sama dengan worker feed)
OPENROUTER_API_KEY=
# Opsional: model penulis artikel (bawaan meta-llama/llama-3.1-8b-instruct)
# ARTICLE_LLM_MODEL=

# Folder bersama
VISUAL_MEMORY_DIR=/home/jauhar/deploy/kauiz/visual-memory
KAUIZ_WORKER_DIR=/home/jauhar/deploy/kauiz/kauiz-worker
ARTICLE_STATE_FILE=/home/jauhar/deploy/article/article_state.json
ARTICLE_OUTPUT_DIR=/home/jauhar/deploy/article/output
