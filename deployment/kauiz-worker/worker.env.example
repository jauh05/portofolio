# Salin ke worker.env di folder yang sama, lalu isi. Jangan commit worker.env.
# chmod 600 worker.env

# ID akun Instagram untuk token Instagram Login: field "id" dari GET graph.instagram.com/me.
KAUIZ_IG_USER_ID=
# Token dengan izin instagram_content_publish. Jangan dicetak ke log.
KAUIZ_IG_ACCESS_TOKEN=

# Host Graph API: graph.instagram.com untuk token Instagram Login, graph.facebook.com untuk token Facebook Login.
KAUIZ_GRAPH_HOST=https://graph.instagram.com
# Versi Graph API. Naikkan hanya setelah dicek di dokumentasi Meta.
KAUIZ_GRAPH_VERSION=v23.0

# Folder yang diservis web server secara publik, dan URL-nya.
# Instagram mengambil gambar dari URL ini, jadi harus bisa diakses dari internet lewat HTTPS.
# URL harus menunjuk ke root folder ini (tanpa subpath). Contoh server block: nginx_kauiz_media.conf.
KAUIZ_PUBLIC_DIR=/var/www/kauiz-media
KAUIZ_PUBLIC_BASE_URL=https://kauiz-media.jauharfauzi.my.id

KAUIZ_TIMEZONE=Asia/Jakarta

# File slot yang ditulis dashboard dari grid Content Planner. Worker hanya mengerjakan slot dari file ini.
KAUIZ_SLOTS_FILE=/var/www/jauharfauzi.my.id/storage/app/kauiz/slots.json

# Opsional: path font TTF brand. Kosong = font default Pillow.
KAUIZ_FONT_BOLD=
KAUIZ_FONT_REGULAR=

# Retry untuk koneksi putus dan error sementara. Rate limit dengan Retry-After
# lebih lama dari KAUIZ_MAX_WAIT_SECONDS tidak ditunggu; slot itu dilewati.
KAUIZ_MAX_RETRIES=3
KAUIZ_MAX_WAIT_SECONDS=300

# Mode gambar. pillow = template tetap bawaan (default). muse = latar dari Muse lewat OpenRouter, teks dari Pillow
# dengan layout per template (27 template) dan font brand.
KAUIZ_IMAGE_MODE=pillow
# Hanya untuk mode muse. Jangan commit nilainya.
OPENROUTER_API_KEY=
# Folder berisi visual_memory.py, visual_overlay.py, file JSON (brands, template, layout), dan fonts/.
# Salin dari repo: JaukiContentBot-integration/visual_*.py dan resources/office-ai/visual-memory/ (termasuk fonts/).
KAUIZ_VISUAL_MEMORY_DIR=/home/jauhar/deploy/kauiz/visual-memory
# Batas panggilan Muse per hari. Latar yang sudah dibuat dipakai ulang dan tidak dihitung lagi.
KAUIZ_MAX_IMAGES_PER_DAY=12

# Teks di gambar. muse = Muse menulis teks persis dari prompt (default, gaya poster seperti referensi).
# pillow = Muse hanya membuat latar, teks ditulis Pillow di zona template.
KAUIZ_TEXT_MODE=muse
# Penulis prompt dan caption untuk materi baru dari analisis dashboard (slot yang punya topik atau key message).
# Memakai Llama lewat OpenRouter dengan API key yang sama seperti Muse (OPENROUTER_API_KEY). Kosongkan KAUIZ_LLM_MODEL
# untuk mematikannya, maka prompt dan caption dirakit dari kartu gaya template.
# Slot tanpa isi memakai bank materi (prompt-bank/), tanpa memanggil model teks, dan tiap materi hanya dipakai sekali.
KAUIZ_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
KAUIZ_LLM_BASE_URL=https://openrouter.ai/api/v1
KAUIZ_LLM_API_KEY=
# Cadangan bila model utama gagal, mis. LiteLLM lokal. Kosong = tanpa cadangan.
KAUIZ_LLM_FALLBACK_MODEL=
KAUIZ_LLM_FALLBACK_BASE_URL=
KAUIZ_LLM_FALLBACK_API_KEY=
# 1 = dry run ikut memanggil model teks untuk slot dari analisis. Hasilnya disimpan dan dipakai lagi oleh run live.
KAUIZ_WRITER_IN_DRYRUN=0

# Pemasangan gambar Muse ke feed. pad (bawaan) = gambar utuh dengan isian buram di sisi, tidak ada yang terpotong.
# crop = dipotong ke 4:5 seperti sebelumnya (bagian atas dan bawah bisa hilang).
KAUIZ_FEED_FIT=pad
